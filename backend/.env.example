#--------------------------------------------------------------------
# Copy this file to ".env" in the backend folder and fill in real values.
# ".env" is git-ignored. NEVER commit real values to this example file.
#--------------------------------------------------------------------

# development | production | testing
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# Database (dedicated local database; do not reuse another application's)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = reseller_domain_manager
database.default.username = CHANGE_ME_DB_USER
database.default.password = CHANGE_ME_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# ResellerClub (backend only; never in Flutter, APK assets, Git or logs)
# Read-only operations only until the renewal phase is approved.
#--------------------------------------------------------------------
resellerclub.baseUrl = CHANGE_ME_PROVIDER_BASE_URL
resellerclub.authUserId = CHANGE_ME_AUTH_USER_ID
resellerclub.apiKey = CHANGE_ME_API_KEY

#--------------------------------------------------------------------
# Authentication (Phase 1b onwards)
#--------------------------------------------------------------------
auth.jwtSecret = CHANGE_ME_LONG_RANDOM_SECRET
